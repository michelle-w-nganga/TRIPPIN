
body {
    margin: 0;
    font-family: 'Caesar Dressing', serif;
    background: linear-gradient(to bottom, #F97C0F 18%, #D8B339 41%, #1763B9 62%);
    color: black;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    min-height: 100vh;
}

.header {
    text-align: center;
    margin-top: 20px;
}

.title {
    font-size: 3rem;
    margin: 0;
    font-weight: bold;
    text-transform: uppercase;
}

.subtitle {
    font-size: 1.5rem;
    margin: 5px 0;
    text-transform: capitalize;
}

main {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-grow: 1;
    width: 100%;
}

.form {
    display: flex;
    flex-direction: column;
    gap: 15px;
    width: 300px;
    text-align: center;
}

input,
select,
button {
    padding: 10px;
    font-size: 1rem;
    border-radius: 5px;
    border: 1px solid #ccc;
}

button {
    background-color: orange;
    color: white;
    border: none;
    cursor: pointer;
}

button:hover {
    background-color: darkorange;
}
